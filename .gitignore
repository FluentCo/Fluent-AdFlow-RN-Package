# Generated native projects (created by setup-examples.sh)
example/android/
example/ios/Pods/
example/ios/build/
example/ios/*.xcworkspace/
example/node_modules/

example-classic/android/
example-classic/ios/Pods/
example-classic/ios/build/
example-classic/ios/*.xcworkspace/
example-classic/node_modules/

# Gitignore ios/android except Podfile and tracked config
!example/ios/Podfile
!example-classic/ios/Podfile

# macOS
.DS_Store

# XCFramework build output
build/

# SPM lock file — not needed for libraries; consumers generate their own
Package.resolved

